{
  "codemode.mode": "only",
  "defaultModel": "opencode/big-pickle",
  "defaultProvider": "opencode-cli",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "enableInstallTelemetry": false,
  "httpIdleTimeoutMs": 0,
  "lastChangelogVersion": "1.6.1",
  "packages": [
    "npm:pi-blackhole",
    "npm:better-pi-rewind",
    "npm:@pi-lab/input-history",
    "npm:@monotykamary/pi-retry",
    "npm:pi-invisible-continue",
    "npm:@mazli/pi-worktree",
    "npm:@matthewfl/pi-simple-goal",
    "npm:pi-opencode-cli-bridge",
    "npm:@tduyng/pi-web",
    "npm:@nilskluewer/pi-subagent",
    "npm:@llblab/pi-telegram"
  ],
  "theme": "dark",
  "notices": {
    "cacheMisses": true,
    "cacheWarming": true,
    "compactionCosts": true,
    "reasoningDrops": true
  }
}
